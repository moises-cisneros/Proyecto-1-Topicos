# ==============================================================================
# SMS Sentinel - Variables de Entorno y Configuración de Puertos
# ==============================================================================
# Todos los puertos han sido configurados deliberadamente en valores no estándar
# para garantizar el aislamiento y evitar colisiones de red con servicios locales.

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# NOTA: Si utilizas PostgreSQL local instalado en tu sistema (ej: Windows), el puerto
# habitual es 5432 y debes usar la contraseña que definiste durante la instalación.
# Si utilizas Docker Compose, el puerto aislado configurado es 5439 con postgres/postgres.
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_sentinel_db

# URL de conexión completa (opcional, tiene prioridad sobre las variables atómicas):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sms_sentinel_db

# Parámetros de Connection Pooling de SQLAlchemy
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=2.0

# ------------------------------------------------------------------------------
# 2. Microservicio REST API con FastAPI (Puerto asignado: 8090)
# ------------------------------------------------------------------------------
API_PORT=8090
PORT=8000

# ------------------------------------------------------------------------------
# 3. Aplicación Frontend Web React / Vite (Puerto asignado: 3090)
# ------------------------------------------------------------------------------
WEB_PORT=3090
VITE_API_BASE_URL=http://localhost:8090
