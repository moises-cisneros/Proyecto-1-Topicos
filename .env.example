# ==============================================================================
# SMS Sentinel - Variables de Entorno y Configuración de Puertos
# ==============================================================================
# Todos los puertos han sido configurados deliberadamente en valores no estándar
# para garantizar el aislamiento y evitar colisiones de red con servicios locales.

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Puerto asignado: 5439)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sms_sentinel_db
DB_PORT=5439

# URL de conexión para acceso local / scripts en el host:
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/sms_sentinel_db

# Parámetros de Connection Pooling de SQLAlchemy
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=2.0

# ------------------------------------------------------------------------------
# 2. Microservicio REST API con FastAPI (Puerto asignado: 8090)
# ------------------------------------------------------------------------------
API_PORT=8090
PORT=8000

# ------------------------------------------------------------------------------
# 3. Aplicación Frontend Web React / Vite (Puerto asignado: 3090)
# ------------------------------------------------------------------------------
WEB_PORT=3090
VITE_API_BASE_URL=http://localhost:8090
