# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code and documentation (LF)
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.ipynb text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
LICENSE text eol=lf

# Windows specific shell scripts (CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no line ending conversion)
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary

