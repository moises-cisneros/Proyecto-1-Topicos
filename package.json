{
  "name": "sms-sentinel-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SMS Sentinel - Detección de Spam y Phishing en SMS mediante NLP y Machine Learning",
  "scripts": {
    "dev": "pnpm --filter sms-sentinel-web dev",
    "build": "pnpm --filter sms-sentinel-web build",
    "preview": "pnpm --filter sms-sentinel-web preview",
    "setup:env": "node scripts/setup_env.cjs",
    "data:prepare": "node scripts/run_python.cjs scripts/prepare_data.py",
    "ml:train": "node scripts/run_python.cjs packages/pipeline/models/train.py",
    "ml:train:fast": "node scripts/run_python.cjs packages/pipeline/models/train.py --fast",
    "ml:train:lemmatize": "node scripts/run_python.cjs packages/pipeline/models/train.py --fast --morphology lemmatization",
    "ml:evaluate": "node scripts/run_python.cjs packages/pipeline/models/evaluate.py",
    "api:dev": "node scripts/run_api.cjs",
    "slides:generate": "node scripts/run_python.cjs scripts/generate_presentation.py",
    "test": "node scripts/run_python.cjs -m pytest -v",
    "test:coverage": "node scripts/run_python.cjs -m pytest --cov=packages/pipeline --cov=packages/api tests/",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "sms",
    "spam-detection",
    "phishing",
    "nlp",
    "machine-learning",
    "fastapi",
    "react",
    "docker"
  ],
  "author": "Moises Cisneros <moisescisnerosdl@gmail.com>",
  "license": "MIT"
}
